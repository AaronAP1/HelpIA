# ===== SOLO PARA DOCKER LOCAL. La app bloquea estos atajos si corre en Azure. =====
FUNCTIONS_WORKER_RUNTIME=java
APP_ENV=local
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
AzureWebJobsSecretStorageType=files
DURABLE_HUB_NAME=HelpiaLocal
# Azure y Core Tools lo definen solos; sin él, el cliente de Durable falla con "Webhooks are not configured".
WEBSITE_HOSTNAME=localhost:7071
# Java 17 en la imagen Linux arranca en ASCII (LANG vacío) y rompe las tildes de los mensajes.
JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8

JWT_LOCAL_BYPASS=true
LOCAL_FAKE_IDENTITY=true
GRAPH_BASE_URL=http://simulador-graph:8080/graph/v1.0

ALLOWED_EMAIL_DOMAINS=pacifico.com.pe,epps.com.pe,pacificovida.com.pe

# Etapa 3: Automation simulado (docker/simulador-automation)
ARM_BASE_URL=http://simulador-automation:8081
AUTOMATION_ACCOUNT_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-helpia-local/providers/Microsoft.Automation/automationAccounts/aa-helpia-local
AUTOMATION_HYBRID_WORKER_GROUP=hrw-local
AUTOMATION_RUNBOOK_DESBLOQUEO=RB-HelpIA-Desbloqueo
AUTOMATION_RUNBOOK_RESETEO=RB-HelpIA-Reseteo
AUTOMATION_RUNBOOK_CELULAR=RB-HelpIA-Celular

# Etapa 3: callback al bot simulado (docker/simulador-bot lee el mismo secreto de este archivo)
CALLBACK_BASE_URL=http://simulador-bot:8082
CALLBACK_HMAC_SECRET=secreto-local-helpia-solo-para-pruebas
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_FIRST_RETRY_SECONDS=2

# Etapa 3: límites diarios en Table Storage (Azurite)
RATE_LIMIT_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://azurite:10002/devstoreaccount1;
